# Copy this file to .env and fill in your own values.

# Port the dashboard/API runs on
PORT=3000

# --- Database (required) ---
# All data (sites, pages, check history, settings) lives in Postgres, so it
# survives redeploys and container restarts — unlike storing it in a file on
# a free hosting platform's disk. A free Neon project (https://neon.tech)
# works well: create a project, copy its "Connection string" (it starts with
# postgresql://...), and paste it here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# These two are only used to seed the schedule/timeout the FIRST time the app
# runs against a brand-new database. After that, both live in the database's
# Settings table and are adjustable live from the dashboard's Settings panel
# (gear icon) — no restart needed.
CHECK_INTERVAL_CRON=0 * * * *
REQUEST_TIMEOUT_MS=10000

# --- Email alerts (optional but recommended) ---
#
# IMPORTANT if you're hosting on Render's free tier (or similar free hosts):
# they block outbound SMTP ports (25/465/587) entirely, so the SMTP_* settings
# below will just time out there — use BREVO_API_KEY instead (see below).
# SMTP works fine for local use, or on hosts that don't block those ports.

# Option 1 (recommended on Render free tier): Brevo's HTTPS API.
# Sign up free at brevo.com, verify a sender email under Senders, Domains &
# Dedicated IPs -> Senders, then create a key under SMTP & API -> API Keys
# (NOT the SMTP key/tab — this needs the API key specifically). This rides
# over normal HTTPS, so it isn't affected by any outbound-port blocking.
BREVO_API_KEY=

# Option 2: plain SMTP (nodemailer) — works with Gmail, Outlook, Zoho,
# Brevo's own SMTP relay, SendGrid, Mailgun, etc. Only used if BREVO_API_KEY
# above is left blank. For Gmail: enable 2FA on the account, then create an
# "App Password" at https://myaccount.google.com/apppasswords and use that as
# SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Who alerts appear to come from (used by both options above), and who
# receives them — ALERT_TO_EMAIL accepts a comma-separated list for multiple
# recipients, e.g. "a@example.com,b@example.com"
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=pash@allpracticesolutions.com

# --- Dashboard access (recommended once this is deployed publicly, e.g. on Render) ---
# If both are set, the whole app (dashboard + API) requires this username/password
# via HTTP Basic Auth. Leave blank for local-only use. If you set these on Render,
# also configure your external scheduler (e.g. cron-job.org) with the same
# username/password in its "Basic Auth" option so its hourly ping can get through.
DASHBOARD_USER=
DASHBOARD_PASS=
