# Copy this file to .env and fill in your own values.

# Port the dashboard/API runs on
PORT=3000

# --- Database (required) ---
# All data (sites, pages, check history, settings) lives in Postgres, so it
# survives redeploys and container restarts — unlike storing it in a file on
# a free hosting platform's disk. A free Neon project (https://neon.tech)
# works well: create a project, copy its "Connection string" (it starts with
# postgresql://...), and paste it here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# These are only used to seed the schedule/timeout/slow-threshold the FIRST
# time the app runs against a brand-new database. After that, all of them
# live in the database's Settings table and are adjustable live from the
# dashboard's Settings panel (gear icon) — no restart needed.
CHECK_INTERVAL_CRON=0 * * * *
REQUEST_TIMEOUT_MS=10000

# A successful (2xx/3xx) response slower than this is classified 'Slow'
# instead of 'Up' — a performance problem, not an availability failure. See
# the README's "A note on Slow vs. Down" for the full rule.
SLOW_THRESHOLD_MS=3000

# Used to build absolute links in the digest email (the "Mark as Fixed" and
# site-detail links) — an email client can't resolve a relative link the way
# a browser does, so set this to wherever the app is actually reachable
# (e.g. https://uptime-watch-xxxx.onrender.com). Leave blank for local-only
# use; the links will just be relative and won't work from an inbox.
APP_BASE_URL=

# --- Email alerts (optional but recommended) ---
#
# IMPORTANT if you're hosting on Render's free tier (or similar free hosts):
# they block outbound SMTP ports (25/465/587) entirely, so the SMTP_* settings
# below will just time out there — use one of the HTTPS API options instead
# (Mailjet or Brevo). SMTP works fine for local use, or on hosts that don't
# block those ports. Only one of the three options below is needed — the app
# checks Mailjet first, then Brevo, then falls back to plain SMTP.

# Option 1 (recommended): Mailjet's HTTPS API — genuinely free (6,000
# emails/month, no credit card), and rides over normal HTTPS so it isn't
# affected by Render's outbound-port blocking. Sign up free at mailjet.com,
# verify a sender email under Account Settings -> Sender addresses & domains
# (Mailjet emails a confirmation link — click it), then grab both keys under
# Account Settings -> API Key Management.
MJ_API_KEY=
MJ_API_SECRET=

# Option 2: Brevo's HTTPS API. Only used if MJ_API_KEY above is left blank.
# Sign up free at brevo.com, verify a sender email under Senders, Domains &
# Dedicated IPs -> Senders, then create a key under SMTP & API -> API Keys
# (NOT the SMTP key/tab — this needs the API key specifically). Note: Brevo
# requires an active plan (including its free plan) with email credits
# remaining — check Usage and plan in Brevo if sends silently fail.
BREVO_API_KEY=

# Option 3: plain SMTP (nodemailer) — works with Gmail, Outlook, Zoho,
# Mailjet's or Brevo's own SMTP relay, SendGrid, Mailgun, etc. Only used if
# neither MJ_API_KEY nor BREVO_API_KEY above is set. For Gmail: enable 2FA on
# the account, then create an "App Password" at
# https://myaccount.google.com/apppasswords and use that as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Who alerts appear to come from (used by all three options above).
ALERT_FROM_EMAIL=

# Who receives the digest email — a comma-separated list, e.g.
# "a@example.com,b@example.com". This only seeds the recipient list the
# FIRST time the app boots against a brand-new database — after that, the
# database is the source of truth, and the real place to manage this list is
# the dashboard's Settings panel ("Alert recipients"), editable live with no
# redeploy needed.
ALERT_TO_EMAIL=pash@allpracticesolutions.com

# --- Dashboard access (recommended once this is deployed publicly, e.g. on Render) ---
# If both are set, the whole app (dashboard + API) requires this username/password
# via HTTP Basic Auth. Leave blank for local-only use. If you set these on Render,
# also configure your external scheduler (e.g. cron-job.org) with the same
# username/password in its "Basic Auth" option so its hourly ping can get through.
DASHBOARD_USER=
DASHBOARD_PASS=
