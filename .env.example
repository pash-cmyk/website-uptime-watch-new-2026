# Copy this file to .env and fill in your own values.

# Port the dashboard/API runs on
PORT=3000

# These two are only used to seed the schedule the FIRST time the app runs
# (when data/uptime-data.xlsx doesn't exist yet). After that, the schedule
# lives in the workbook's Settings sheet and is adjustable live from the
# dashboard's Settings panel (gear icon) — no restart needed.
CHECK_INTERVAL_CRON=0 * * * *
REQUEST_TIMEOUT_MS=10000

# --- Email alerts (optional but recommended) ---
# Uses standard SMTP, so this works with Gmail, Outlook, Zoho, SendGrid, Mailgun, etc.
# For Gmail: enable 2FA on the account, then create an "App Password" at
# https://myaccount.google.com/apppasswords and use that as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Who alerts appear to come from, and who receives them
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=pash@allpracticesolutions.com

# --- Dashboard access (recommended once this is deployed publicly, e.g. on Render) ---
# If both are set, the whole app (dashboard + API) requires this username/password
# via HTTP Basic Auth. Leave blank for local-only use. If you set these on Render,
# also configure your external scheduler (e.g. cron-job.org) with the same
# username/password in its "Basic Auth" option so its hourly ping can get through.
DASHBOARD_USER=
DASHBOARD_PASS=
